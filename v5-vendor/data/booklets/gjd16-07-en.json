    {
      "type": "content",
      "label": "CHARGING — STEP 1",
      "title": "CHARGING — STEP 1",
      "variant": "warning",
      "displayNumber": 8,
      "blocks": [
        {
          "kind": "paragraph",
          "text": "Charging the device"
        },
        {
          "kind": "paragraph",
          "text": "Apply the magnetic end of the cable to the back of the device"
        },
        {
          "kind": "warning",
          "text": "Please be especially careful and do not connect devices that are wet or damp from sweat for charging. Charging a damp device causes corrosion and damage to the device."
        }
      ]
    },
    {
      "type": "content",
      "label": "CHARGING — STEP 2",
      "title": "CHARGING — STEP 2",
      "variant": "warning",
      "displayNumber": 9,
      "blocks": [
        {
          "kind": "paragraph",
          "text": "Connect the USB cable end to the power adapter"
        },
        {
          "kind": "warning",
          "text": "The power adapter is not included in the set"
        }
      ]
    },
    {
      "type": "content",
      "label": "CHARGING — STEP 3",
      "title": "CHARGING — STEP 3",
      "variant": "warning",
      "displayNumber": 10,
      "blocks": [
        {
          "kind": "paragraph",
          "text": "Connect the power adapter to the electrical outlet"
        },
        {
          "kind": "warning",
          "text": "Make sure you have correctly connected the entire set. Incorrect connection of the device may cause its damage."
        }
      ]
    },
    {
      "type": "content",
      "label": "TURNING ON AND OFF",
      "title": "TURNING ON AND OFF",
      "variant": "default",
      "displayNumber": 11,
      "blocks": [
        {
          "kind": "paragraph",
          "text": "Turning the device on and off"
        },
        {
          "kind": "paragraph",
          "text": "To turn on the device"
        },
        {
          "kind": "paragraph",
          "text": "hold the function button for approximately 3 seconds."
        },
        {
          "kind": "paragraph",
          "text": "To turn off the device, in the watch menu select \"More\", then \"Settings\", \"Turn off\", and then again \"Turn off\"."
        }
      ]
    },
    {
      "type": "content",
      "label": "SOS ALARM ACTIVATION",
      "title": "SOS ALARM ACTIVATION",
      "variant": "default",
      "displayNumber": 12,
      "blocks": [
        {
          "kind": "paragraph",
          "text": "SOS alarm activation"
        },
        {
          "kind": "paragraph",
          "text": "Turn on the device"
        },
        {
          "kind": "paragraph",
          "text": "The device must be turned on to use the SOS button."
        },
        {
          "kind": "paragraph",
          "text": "Device turned on"
        },
        {
          "kind": "paragraph",
          "text": "With the device turned on: holding the SOS button sends an SOS alarm to the phone and establishes a connection with the guardian."
        }
      ]
    },
    {
      "type": "content",
      "label": "TIPS",
      "title": "TIPS",
      "variant": "default",
      "displayNumber": 13,
      "blocks": [
        {
          "kind": "paragraph",
          "text": "Tip"
        },
        {
          "kind": "paragraph",
          "text": "The phone number used for registration in the application is automatically added to the device as the main alarm number."
        },
        {
          "kind": "paragraph",
          "text": "Remember to add contact numbers in the Safe Family application. Only contact numbers added in the application will be able to call the watch."
        },
        {
          "kind": "paragraph",
          "text": "Setting all ten authorized numbers is not mandatory."
        },
        {
          "kind": "paragraph",
          "text": "Tip"
        },
        {
          "kind": "paragraph",
          "text": "After pressing the SOS button, the connection with the guardian may take a little longer, e.g. when the phone is in an area with poor signal. In some cases, it is also possible to connect to the guardian's voicemail."
        }
      ]
    },
