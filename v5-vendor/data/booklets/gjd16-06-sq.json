    {
      "type": "content",
      "label": "KOPERTINA",
      "title": "KOPERTINA",
      "variant": "cover",
      "displayNumber": 1,
      "blocks": [
        {
          "kind": "paragraph",
          "text": "Fillimi i shpejtë dhe karta e garancisë"
        },
        {
          "kind": "paragraph",
          "text": "Orë inteligjente"
        },
        {
          "kind": "paragraph",
          "text": "LOCON WATCH SLAY AI"
        },
        {
          "kind": "paragraph",
          "text": "MODELI GJD.16"
        },
        {
          "kind": "paragraph",
          "text": "Versioni 003"
        }
      ]
    },
    {
      "type": "content",
      "label": "QR + KONTAKTI",
      "title": "QR + KONTAKTI",
      "variant": "qr",
      "displayNumber": 2,
      "blocks": [
        {
          "kind": "paragraph",
          "text": "Skanoni kodin dhe hapni udhëzimet e plota të përdorimit"
        },
        {
          "kind": "paragraph",
          "text": "Keni pyetje?"
        },
        {
          "kind": "paragraph",
          "text": "Na shkruani: help@locon.pl"
        }
      ]
    },
    {
      "type": "content",
      "label": "SI TË FILLONI — HAPI 1",
      "title": "SI TË FILLONI — HAPI 1",
      "variant": "default",
      "displayNumber": 3,
      "blocks": [
        {
          "kind": "paragraph",
          "text": "Si të filloni?"
        },
        {
          "kind": "paragraph",
          "text": "Shkarkoni dhe instaloni aplikacionin Safe Family në telefonin tuaj"
        },
        {
          "kind": "paragraph",
          "text": "SHKARKO NGA"
        },
        {
          "kind": "paragraph",
          "text": "Skanoni kodin për të shtuar aplikacionin"
        }
      ]
    },
    {
      "type": "content",
      "label": "HAPI 2",
      "title": "HAPI 2",
      "variant": "default",
      "displayNumber": 4,
      "blocks": [
        {
          "kind": "paragraph",
          "text": "Nisni aplikacionin Safe Family:"
        },
        {
          "kind": "paragraph",
          "text": "Vendosni numrin tuaj të telefonit, në të cilin do të merrni një SMS me kodin për hyrje (dhe konfirmimin e numrit të telefonit)."
        }
      ]
    },
    {
      "type": "content",
      "label": "HAPI 3",
      "title": "HAPI 3",
      "variant": "default",
      "displayNumber": 5,
      "blocks": [
        {
          "kind": "paragraph",
          "text": "Shtoni pajisjen në aplikacion:"
        },
        {
          "kind": "paragraph",
          "text": "Shtypni butonin „Zgjidh“ në fushën „Dëshiroj të lokalizoj një pajisje tjetër GPS“."
        },
        {
          "kind": "paragraph",
          "text": "Skanoni kodin QR nga kutia ose pajisja"
        },
        {
          "kind": "paragraph",
          "text": "Ndiqni udhëzimet e mëtejshme në aplikacion"
        }
      ]
    },
    {
      "type": "content",
      "label": "HAPI 4",
      "title": "HAPI 4",
      "variant": "warning",
      "displayNumber": 6,
      "blocks": [
        {
          "kind": "paragraph",
          "text": "Nëse posedoni pajisjen së bashku me kartën SIM të dorëzuar nga Locon, pas kryerjes së hapave të mëparshëm pajisja juaj do të jetë gati për përdorim brenda disa minutash."
        },
        {
          "kind": "warning",
          "text": "Kujdes! Karta juaj SIM nuk duhet të ketë kod PIN."
        },
        {
          "kind": "paragraph",
          "text": "Si të instaloni kartën tuaj SIM? Udhëzimet e plota do t'i gjeni në Udhëzuesin e Përdorimit (kodi QR në faqen 2) ose duke kontaktuar linjën e ndihmës së Locon."
        }
      ]
    },
    {
      "type": "content",
      "label": "NJIHNI PAJISJEN TUAJ",
      "title": "NJIHNI PAJISJEN TUAJ",
      "variant": "default",
      "displayNumber": 7,
      "blocks": [
        {
          "kind": "paragraph",
          "text": "Njihni pajisjen tuaj"
        },
        {
          "kind": "paragraph",
          "text": "Ana e përparme"
        },
        {
          "kind": "paragraph",
          "text": "Kamera"
        },
        {
          "kind": "paragraph",
          "text": "Butoni Funksional"
        },
        {
          "kind": "paragraph",
          "text": "Ndezja dhe fikja e pajisjes"
        },
        {
          "kind": "paragraph",
          "text": "Kthimi në pamjen e mëparshme"
        },
        {
          "kind": "paragraph",
          "text": "Butoni SOS"
        },
        {
          "kind": "paragraph",
          "text": "Dërgimi i SOS"
        },
        {
          "kind": "paragraph",
          "text": "Kthimi në ekranin kryesor"
        },
        {
          "kind": "paragraph",
          "text": "Ana anësore/e pasme"
        },
        {
          "kind": "paragraph",
          "text": "Foleja për kartën SIM"
        },
        {
          "kind": "paragraph",
          "text": "Kontaktet e karikimit"
        }
      ]
    },
    {
      "type": "content",
      "label": "KARIKIMI — HAPI 1",
      "title": "KARIKIMI — HAPI 1",
      "variant": "warning",
      "displayNumber": 8,
      "blocks": [
        {
          "kind": "paragraph",
          "text": "Karikimi i pajisjes"
        },
        {
          "kind": "paragraph",
          "text": "Vendosni nga ana e pasme e pajisjes skajin magnetik të kabllos"
        },
        {
          "kind": "warning",
          "text": "Ju lutemi tregoni kujdes të veçantë dhe mos lidhni për karikim pajisje që janë të lagura ose të lagështa nga djersa. Karikimi i pajisjes së lagësht shkakton korrozion dhe dëmtimin e pajisjes."
        }
      ]
    },
    {
      "type": "content",
      "label": "KARIKIMI — HAPI 2",
      "title": "KARIKIMI — HAPI 2",
      "variant": "warning",
      "displayNumber": 9,
      "blocks": [
        {
          "kind": "paragraph",
          "text": "Lidhni me adapterin e ushqimit skajin e kabllos USB"
        },
        {
          "kind": "warning",
          "text": "Adapteri i ushqimit nuk përfshihet në komplet"
        }
      ]
    },
    {
      "type": "content",
      "label": "KARIKIMI — HAPI 3",
      "title": "KARIKIMI — HAPI 3",
      "variant": "warning",
      "displayNumber": 10,
      "blocks": [
        {
          "kind": "paragraph",
          "text": "Lidhni adapterin e ushqimit me prizën elektrike"
        },
        {
          "kind": "warning",
          "text": "Sigurohuni që e keni lidhur drejt të gjithë kompletin. Lidhja e gabuar e pajisjes mund të shkaktojë dëmtimin e saj."
        }
      ]
    },
    {
      "type": "content",
      "label": "NDEZJA DHE FIKJA",
      "title": "NDEZJA DHE FIKJA",
      "variant": "default",
      "displayNumber": 11,
      "blocks": [
        {
          "kind": "paragraph",
          "text": "Ndezja dhe fikja e pajisjes"
        },
        {
          "kind": "paragraph",
          "text": "Për të ndezur pajisjen"
        },
        {
          "kind": "paragraph",
          "text": "duhet të mbani butonin funksional për rreth 3 sekonda."
        },
        {
          "kind": "paragraph",
          "text": "Për të fikur pajisjen, në menynë e orës zgjidhni „Më shumë“, pastaj „Cilësimet”, „Fik”, dhe përsëri „Fik”."
        }
      ]
    },
    {
      "type": "content",
      "label": "AKTIVIZIMI I ALARMIT SOS",
      "title": "AKTIVIZIMI I ALARMIT SOS",
      "variant": "default",
      "displayNumber": 12,
      "blocks": [
        {
          "kind": "paragraph",
          "text": "Aktivizimi i alarmit SOS"
        },
        {
          "kind": "paragraph",
          "text": "Ndizni pajisjen"
        },
        {
          "kind": "paragraph",
          "text": "Pajisja duhet të jetë e ndezur për të përdorur butonin SOS."
        },
        {
          "kind": "paragraph",
          "text": "Pajisja e ndezur"
        },
        {
          "kind": "paragraph",
          "text": "Me pajisjen e ndezur: mbajtja e butonit SOS shkakton dërgimin e alarmit SOS në telefon dhe lidhjen me kujdestarin."
        }
      ]
    },
    {
      "type": "content",
      "label": "KËSHILLA",
      "title": "KËSHILLA",
      "variant": "default",
      "displayNumber": 13,
      "blocks": [
        {
          "kind": "paragraph",
          "text": "Këshillë"
        },
        {
          "kind": "paragraph",
          "text": "Numri i telefonit i përdorur për regjistrim në aplikacion shtohet automatikisht në pajisje si numri kryesor i alarmit."
        },
        {
          "kind": "paragraph",
          "text": "Mos harroni të shtoni numrat e kontaktit në aplikacionin Safe Family. Vetëm numrat e kontaktit të shtuar në aplikacion do të mund të telefonojnë në orë."
        },
        {
          "kind": "paragraph",
          "text": "Vendosja e të gjithë dhjetë numrave të autorizuar nuk është e detyrueshme."
        },
        {
          "kind": "paragraph",
          "text": "Këshillë"
        },
        {
          "kind": "paragraph",
          "text": "Pas shtypjes së butonit SOS lidhja me kujdestarin mund të zgjatë pak më shumë, p.sh. kur telefoni ndodhet në vend me sinjal të dobët. Në disa raste është e mundur edhe lidhja me postën zanore të kujdestarit."
        }
      ]
    },
    {
      "type": "content",
      "label": "KRYERJA E THIRRJES",
      "title": "KRYERJA E THIRRJES",
      "variant": "default",
      "displayNumber": 14,
      "blocks": [
        {
          "kind": "paragraph",
          "text": "Kryerja e thirrjes telefonike"
        },
        {
          "kind": "paragraph",
          "text": "Për të kryer një thirrje"
        },
        {
          "kind": "paragraph",
          "text": "Zgjidhni në meny „Telefoni“. Shtypni mbi emrin e kontaktit të zgjedhur, pastaj përsëri zgjidhni „Telefoni”."
        },
        {
          "kind": "paragraph",
          "text": "Kontakti"
        },
        {
          "kind": "paragraph",
          "text": "Mama"
        },
        {
          "kind": "paragraph",
          "text": "Telefoni"
        },
        {
          "kind": "paragraph",
          "text": "Cilësimet"
        },
        {
          "kind": "paragraph",
          "text": "WeChat"
        },
        {
          "kind": "paragraph",
          "text": "Video thirrje"
        }
      ]
    },
    {
      "type": "content",
      "label": "PARALAJMËRIME",
      "title": "PARALAJMËRIME",
      "variant": "default",
      "displayNumber": 15,
      "blocks": [
        {
          "kind": "paragraph",
          "text": "Paralajmërime"
        },
        {
          "kind": "paragraph",
          "text": "Për të zgjatur jetëgjatësinë e pajisjes, ndiqni udhëzimet:"
        },
        {
          "kind": "list",
          "items": [
            "Mos përdorni dhe mos ruani pajisjen në vende me pluhur.",
            "Mos vendosni pajisjen në temperaturë më të lartë ose më të ulët se e rekomanduar.",
            "Pajisja duhet të pastrohet me një leckë të thatë. Mos e pastroni pajisjen me mjete kimike ose detergjentë.",
            "Mos e çmontoni dhe mos e montoni përsëri pajisjen.",
            "Përdorimi i baterive të ndryshme nga ato të integruara në pajisje do të shkaktojë efekte të padëshiruara dhe humbje të garancisë."
          ]
        }
      ]
    },
