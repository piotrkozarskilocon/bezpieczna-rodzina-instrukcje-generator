    {
      "type": "content",
      "label": "KORAK 3",
      "title": "KORAK 3",
      "variant": "default",
      "displayNumber": 5,
      "blocks": [
        {
          "kind": "paragraph",
          "text": "Dodajte uređaj u aplikaciju:"
        },
        {
          "kind": "paragraph",
          "text": "Pritisnite gumb „Odaberi“ u polju „Želim locirati drugi GPS uređaj“."
        },
        {
          "kind": "paragraph",
          "text": "Skenirajte QR kod s kutije ili uređaja"
        },
        {
          "kind": "paragraph",
          "text": "Postupajte prema daljnjim uputama u aplikaciji"
        }
      ]
