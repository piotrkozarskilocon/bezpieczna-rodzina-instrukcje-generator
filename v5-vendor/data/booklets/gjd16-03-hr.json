      "label": "KORAK 2",
      "title": "KORAK 2",
      "variant": "default",
      "displayNumber": 4,
      "blocks": [
        {
          "kind": "paragraph",
          "text": "Pokrenite aplikaciju Safe Family:"
        },
        {
          "kind": "paragraph",
          "text": "Unesite svoj telefonski broj na koji ćete dobiti SMS s kodom za prijavu (i potvrdu telefonskog broja)."
