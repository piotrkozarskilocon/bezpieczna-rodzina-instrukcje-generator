      "variant": "default",
      "displayNumber": 3,
      "blocks": [
        {
          "kind": "paragraph",
          "text": "Cum să începeți?"
        },
        {
          "kind": "paragraph",
          "text": "Descărcați și instalați aplicația Safe Family pe telefonul dumneavoastră"
        },
        {
          "kind": "paragraph",
          "text": "DESCARCĂ DIN"
        },
        {
          "kind": "paragraph",
          "text": "Scanați codul pentru a adăuga aplicația"
