    {
      "type": "content",
      "label": "QR + КОНТАКТ",
      "title": "QR + КОНТАКТ",
      "variant": "qr",
      "displayNumber": 2,
      "blocks": [
        {
          "kind": "paragraph",
          "text": "Сканирайте кода и отворете пълната инструкция за употреба"
        },
        {
          "kind": "paragraph",
          "text": "Имате въпроси?"
        },
        {
